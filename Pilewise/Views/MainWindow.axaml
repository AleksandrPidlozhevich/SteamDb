<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pilewise.ViewModels"
        xmlns:views="using:Pilewise.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
        x:Class="Pilewise.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Pilewise.ico"
        Title="Pilewise"
        Width="900" Height="640" MinWidth="720" MinHeight="480"
        DragDrop.AllowDrop="True"
        WindowStartupLocation="CenterScreen">

    <!-- Previewer only; at runtime the DataContext comes from the DI container (App.axaml.cs). -->
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <!-- Shared styles (panels, pills, ⓘ buttons, banners…) are in Styles/Common.axaml. -->
    <Window.Styles>
        <!-- Each page: a readable column that scrolls when the window is short. -->
        <Style Selector="StackPanel.page">
            <Setter Property="Margin" Value="28,20,28,24" />
            <Setter Property="MaxWidth" Value="760" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- Panel header: icon, title (+ one-line description), and a status / tick on the right. -->
        <Style Selector="Grid.panel-header > StackPanel">
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Rows of buttons under a panel's fields. -->
        <!-- Wraps when the window is too narrow for the whole row. -->
        <Style Selector="WrapPanel.actions">
            <Setter Property="ItemSpacing" Value="8" />
            <Setter Property="LineSpacing" Value="8" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style Selector="WrapPanel.actions > Button">
            <Setter Property="Padding" Value="16,7" />
        </Style>

        <Style Selector="WrapPanel.fields">
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style Selector="WrapPanel.fields > StackPanel">
            <Setter Property="Margin" Value="0,0,16,8" />
        </Style>
    </Window.Styles>

    <!-- Root fades in briefly when the theme changes (MainWindow.axaml.cs), so the switch is soft. -->
    <Grid x:Name="Root" ColumnDefinitions="Auto,*">
        <Grid.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseOut" />
            </Transitions>
        </Grid.Transitions>

        <!-- On Windows a hidden pre-warm WebView2 is added here in code (MainWindow.axaml.cs). -->

        <!-- ===== Sidebar: pages, update, support, theme, version. Collapses to icons (the menu button). ===== -->
        <Border Grid.Column="0" Width="{Binding SidebarWidth}" ClipToBounds="True"
                Background="#14808080" BorderBrush="#26808080" BorderThickness="0,0,1,0">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
            </Border.Transitions>
            <DockPanel Margin="10,14,10,12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,18">
                    <Button Classes="icon-button" Width="44" Height="40"
                            ToolTip.Tip="{Binding SidebarToggleTip}" AutomationProperties.Name="{Binding SidebarToggleTip}"
                            Command="{Binding ToggleSidebarCommand}">
                        <PathIcon Width="18" Height="18" Data="{DynamicResource MenuIcon}" />
                    </Button>
                    <Svg Path="/Assets/Pilewise.svg" Width="36" Height="36" VerticalAlignment="Center" IsVisible="{Binding IsSidebarExpanded}" />
                    <TextBlock Text="Pilewise" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                               IsVisible="{Binding IsSidebarExpanded}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Spacing="6">
                    <!-- A newer version is out: download it and restart (same as the banner / Settings). -->
                    <Button Classes="accent" HorizontalAlignment="Stretch" Padding="10,7"
                            IsVisible="{Binding IsUpdateAvailable}"
                            ToolTip.Tip="{Binding UpdateButtonText}"
                            Command="{Binding InstallUpdateCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="18" Height="18" Data="{DynamicResource DownloadIcon}" />
                            <TextBlock Text="{Binding UpdateButtonText}" VerticalAlignment="Center"
                                       IsVisible="{Binding IsSidebarExpanded}" />
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Background="Transparent" Padding="11,6"
                            ToolTip.Tip="Support the project on Ko-fi"
                            Command="{Binding OpenLinkKofiCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image Source="{SvgImage /Assets/ko-fi.svg}" Width="22" Height="22" />
                            <TextBlock Text="Support on Ko-fi" VerticalAlignment="Center"
                                       IsVisible="{Binding IsSidebarExpanded}" />
                        </StackPanel>
                    </Button>
                    <!-- Expanded: the three-way theme switch + version. Collapsed: one button cycling them. -->
                    <Grid ColumnDefinitions="Auto,*" Margin="2,4,0,0" IsVisible="{Binding IsSidebarExpanded}">
                        <views:ThemeSwitch />
                        <TextBlock Grid.Column="1" FontSize="11" Opacity="0.55" Margin="0,0,4,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding AppVersion}" />
                    </Grid>
                    <Button Classes="icon-button" Width="44" Height="36" IsVisible="{Binding IsSidebarCollapsed}"
                            ToolTip.Tip="{Binding ThemeTip}" AutomationProperties.Name="{Binding ThemeTip}"
                            Command="{Binding CycleThemeCommand}">
                        <Panel>
                            <PathIcon Width="16" Height="16" Data="{DynamicResource ThemeSystemIcon}" IsVisible="{Binding IsSystemTheme}" />
                            <PathIcon Width="16" Height="16" Data="{DynamicResource ThemeLightIcon}" IsVisible="{Binding IsLightTheme}" />
                            <PathIcon Width="16" Height="16" Data="{DynamicResource ThemeDarkIcon}" IsVisible="{Binding IsDarkTheme}" />
                        </Panel>
                    </Button>
                </StackPanel>

                <!-- Collapsed: icons only, with the page name as a tooltip. -->
                <ListBox Classes="nav" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
                    <ListBoxItem ToolTip.Tip="Sources" ToolTip.ServiceEnabled="{Binding IsSidebarCollapsed}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{DynamicResource NavSourcesIcon}" />
                            <TextBlock Text="Sources" VerticalAlignment="Center" IsVisible="{Binding IsSidebarExpanded}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip.Tip="Export" ToolTip.ServiceEnabled="{Binding IsSidebarCollapsed}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{DynamicResource NavExportIcon}" />
                            <TextBlock Text="Export" VerticalAlignment="Center" IsVisible="{Binding IsSidebarExpanded}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip.Tip="Automation" ToolTip.ServiceEnabled="{Binding IsSidebarCollapsed}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{DynamicResource NavAutomationIcon}" />
                            <TextBlock Text="Automation" VerticalAlignment="Center" IsVisible="{Binding IsSidebarExpanded}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip.Tip="Settings" ToolTip.ServiceEnabled="{Binding IsSidebarCollapsed}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{DynamicResource NavSettingsIcon}" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" IsVisible="{Binding IsSidebarExpanded}" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== Content: banners on top, then the selected page ===== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <!-- Top slot: progress bar, or the update banner, or the result banner. -->
            <Panel Grid.Row="0" Margin="28,16,28,0">
                <!-- Progress bar (while fetching / syncing) + Cancel. -->
                <Grid Height="20" ColumnDefinitions="*,Auto" IsVisible="{Binding Progress.IsBusy}">
                    <Panel Grid.Column="0">
                        <ProgressBar Height="20"
                                     IsIndeterminate="{Binding Progress.IsIndeterminate}"
                                     Minimum="0"
                                     Maximum="{Binding Progress.Maximum}"
                                     Value="{Binding Progress.Value}" />
                        <TextBlock FontSize="11"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Text="{Binding Progress.Status}" />
                    </Panel>
                    <Button Grid.Column="1" Content="Cancel" FontSize="11" Padding="10,0" Margin="8,0,0,0"
                            VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                            Command="{Binding Progress.CancelCommand}" />
                </Grid>

                <!-- Update banner: a newer release was found on GitHub at startup (Velopack). Hidden
                     while busy and while a result is shown (same slot). -->
                <Border Classes="banner info">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsUpdateAvailable" />
                            <Binding Path="!Progress.IsBusy" />
                            <Binding Path="!HasResult" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                                   Text="{Binding AvailableUpdateVersion, StringFormat='A new version v{0} is available'}" />
                        <Button Grid.Column="1" Classes="accent" Content="Update &amp; restart"
                                Command="{Binding InstallUpdateCommand}" />
                    </Grid>
                </Border>

                <!-- Result banner: outcome of the last export + up to two follow-up actions. -->
                <Border Classes="banner success">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="HasResult" />
                            <Binding Path="!Progress.IsBusy" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Text="{Binding ResultMessage}"
                                   ToolTip.Tip="{Binding ResultMessage}" />
                        <Button Grid.Column="1" Content="{Binding ResultActionLabel}"
                                IsVisible="{Binding HasResultAction}" Command="{Binding RunResultActionCommand}" />
                        <Button Grid.Column="2" Content="{Binding ResultSecondaryLabel}" Margin="6,0,0,0"
                                IsVisible="{Binding HasResultSecondaryAction}"
                                Command="{Binding RunResultSecondaryActionCommand}" />
                        <Button Grid.Column="3" Classes="dismiss" Command="{Binding DismissResultCommand}" />
                    </Grid>
                </Border>
            </Panel>

            <!-- The pages, in sidebar order (MainTab). Disabled while something runs; the sidebar and
                 the Cancel button above stay usable. -->
            <Carousel Grid.Row="1" SelectedIndex="{Binding SelectedTab}" IsEnabled="{Binding !Progress.IsBusy}">

                <!-- ===== Sources ===== -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Classes="page">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Classes="page-title" Text="Sources" />
                                <TextBlock Classes="page-subtitle"
                                           Text="Where your games come from. Untick a store to leave it out of exports, the library and auto-sync." />
                            </StackPanel>
                            <!-- Browse the merged library (nothing is exported). -->
                            <Button Grid.Column="1" Classes="accent" Content="View library…" Padding="18,8"
                                    Margin="16,4,0,0" VerticalAlignment="Top"
                                    ToolTip.Tip="{Binding LibraryHint, TargetNullValue='Browse what will be exported: search, filter, hide demos, or let Pilewise pick a game'}"
                                    ToolTip.ShowOnDisabled="True"
                                    Command="{Binding ViewLibraryCommand}" />
                        </Grid>

                        <Border Classes="panel">
                            <StackPanel>
                                <Grid Classes="panel-header" ColumnDefinitions="Auto,*,Auto">
                                    <Svg Classes="icon" Path="/Assets/steam.svg" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Classes="panel-title" Text="Steam" />
                                        <TextBlock Classes="hint" Text="Your Web API key and Steam ID (or profile link)." />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Classes="include" Content="Include"
                                              IsChecked="{Binding IncludeSteam}" />
                                </Grid>
                                <WrapPanel Classes="fields">
                                    <StackPanel Classes="field-row">
                                        <TextBox Classes="field revealPasswordButton" PasswordChar="*"
                                                 PlaceholderText="Steam API key"
                                                 Text="{Binding SteamApiKey, Mode=TwoWay}" />
                                        <Button Classes="info"
                                                ToolTip.Tip="How to get a Steam Web API key"
                                                AutomationProperties.Name="How to get a Steam Web API key"
                                                Command="{Binding OpenSteamApiKeyInfoCommand}" />
                                    </StackPanel>
                                    <StackPanel Classes="field-row">
                                        <!-- Not a secret, so not masked. Accepts the id, a profile link or a custom-URL name. -->
                                        <TextBox Classes="field"
                                                 PlaceholderText="Steam ID or profile link"
                                                 Text="{Binding SteamId, Mode=TwoWay}" />
                                        <Button Classes="info"
                                                ToolTip.Tip="How to find your Steam ID"
                                                AutomationProperties.Name="How to find your Steam ID"
                                                Command="{Binding OpenInfoLinkSteamIdCommand}" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="panel">
                            <StackPanel Spacing="12">
                                <Grid Classes="panel-header" ColumnDefinitions="Auto,*,Auto">
                                    <Image Classes="icon" Source="{DynamicResource EpicIcon}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Classes="panel-title" Text="Epic Games" />
                                        <TextBlock Classes="hint" Text="Log in in your browser, then paste the code it shows." />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Classes="include" Content="Include"
                                              IsChecked="{Binding IncludeEpic}" />
                                </Grid>
                                <views:StoreConnectRow DataContext="{Binding Epic}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="panel">
                            <StackPanel Spacing="12">
                                <Grid Classes="panel-header" ColumnDefinitions="Auto,*,Auto">
                                    <Image Classes="icon" Source="{DynamicResource GogIcon}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Classes="panel-title" Text="GOG" />
                                        <TextBlock Classes="hint" Text="Log in once; Pilewise keeps the session." />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Classes="include" Content="Include"
                                              IsChecked="{Binding IncludeGog}" />
                                </Grid>
                                <views:StoreConnectRow DataContext="{Binding Gog}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="panel">
                            <StackPanel Spacing="12">
                                <Grid Classes="panel-header" ColumnDefinitions="Auto,*,Auto">
                                    <Image Classes="icon" Source="{DynamicResource XboxIcon}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Classes="panel-title" Text="Xbox" />
                                        <TextBlock Classes="hint" Text="Games you've played on Xbox / PC Game Pass, with Microsoft account login." />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Classes="include" Content="Include"
                                              IsChecked="{Binding IncludeXbox}" />
                                </Grid>
                                <views:StoreConnectRow DataContext="{Binding Xbox}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Export ===== -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Classes="page">
                        <TextBlock Classes="page-title" Text="Export" />
                        <TextBlock Classes="page-subtitle"
                                   Text="Send your library to a tracker. Exports merge: your ticks, notes and extra columns are kept." />

                        <Border Classes="banner warning" Margin="0,0,0,12" Padding="12,6"
                                IsVisible="{Binding HasNoSource}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="Nothing to export yet: enter your Steam key and ID, or connect a store." />
                                <Button Grid.Column="1" Content="Go to Sources" Margin="8,0,0,0"
                                        Command="{Binding GoToSourcesCommand}" />
                            </Grid>
                        </Border>

                        <!-- CSV -->
                        <Border Classes="panel">
                            <StackPanel>
                                <Grid Classes="panel-header" ColumnDefinitions="Auto,*,Auto">
                                    <Image Classes="icon" Source="{DynamicResource CsvIcon}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Classes="panel-title" Text="CSV file" />
                                        <TextBlock Classes="hint" Text="A spreadsheet file on this computer (opens in Excel)." />
                                    </StackPanel>
                                    <Border Grid.Column="2" Classes="pill" Classes.ready="{Binding CanFetchLibrary}">
                                        <TextBlock Text="{Binding CsvStatus}" />
                                    </Border>
                                </Grid>
                                <WrapPanel Classes="actions">
                                    <Button Classes="accent" Content="Export to .csv" Command="{Binding ExportToCsvCommand}"
                                            ToolTip.Tip="{Binding LibraryHint}" ToolTip.ShowOnDisabled="True" />
                                    <Button Content="Update .csv…" Command="{Binding UpdateCsvCommand}"
                                            ToolTip.Tip="Add new games to a CSV you exported before (a .bak copy is kept)"
                                            ToolTip.ShowOnDisabled="True" />
                                    <TextBlock Classes="last-sync" Margin="8,0,0,0" Text="{Binding CsvLastSync}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Notion -->
                        <Border Classes="panel">
                            <StackPanel>
                                <Grid Classes="panel-header" ColumnDefinitions="Auto,*,Auto">
                                    <Image Classes="icon" Source="{DynamicResource NotionIcon}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Classes="panel-title" Text="Notion" />
                                        <TextBlock Classes="hint" Text="Adds and updates pages in your Notion database. You see a preview before anything is written." />
                                    </StackPanel>
                                    <Border Grid.Column="2" Classes="pill" Classes.ready="{Binding CanExportNotion}">
                                        <TextBlock Text="{Binding NotionStatus}" />
                                    </Border>
                                </Grid>
                                <WrapPanel Classes="fields">
                                    <StackPanel Classes="field-row">
                                        <TextBox Classes="field revealPasswordButton" PasswordChar="*"
                                                 PlaceholderText="Notion integration token"
                                                 Text="{Binding NotionToken, Mode=TwoWay}" />
                                        <Button Classes="info"
                                                ToolTip.Tip="How to create a Notion integration token"
                                                AutomationProperties.Name="How to create a Notion integration token"
                                                Command="{Binding OpenInfoLinkNotionTokenCommand}" />
                                    </StackPanel>
                                    <StackPanel Classes="field-row">
                                        <TextBox Classes="field revealPasswordButton" PasswordChar="*"
                                                 PlaceholderText="Database ID"
                                                 Text="{Binding DbId, Mode=TwoWay}" />
                                        <Button Classes="info"
                                                ToolTip.Tip="How to find your Notion database ID"
                                                AutomationProperties.Name="How to find your Notion database ID"
                                                Command="{Binding OpenInfoLinkNotionDbIdCommand}" />
                                    </StackPanel>
                                </WrapPanel>
                                <WrapPanel Classes="actions" Margin="0,4,0,0">
                                    <Button Classes="accent" Content="Export to Notion" Command="{Binding ExportToNotionCommand}"
                                            ToolTip.Tip="{Binding NotionHint}" ToolTip.ShowOnDisabled="True" />
                                    <Button Content="Find duplicates…" Command="{Binding FindNotionDuplicatesCommand}"
                                            ToolTip.Tip="Find pages of the same game in the database and merge them (you confirm first)"
                                            ToolTip.ShowOnDisabled="True" />
                                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Classes="last-sync" Text="{Binding NotionLastSync}" />
                                        <TextBlock Classes="last-sync" Text="{Binding NotionProgress}"
                                                   ToolTip.Tip="Pages ticked as completed in Notion (a Completed / Done checkbox or a Status set to Done), as of the last export" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Google Sheets -->
                        <Border Classes="panel">
                            <StackPanel>
                                <Grid Classes="panel-header" ColumnDefinitions="Auto,*,Auto">
                                    <Svg Classes="icon" Path="/Assets/google-sheets-2026.svg" />
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="panel-title" Text="Google Sheets" />
                                            <Border Classes="chip" VerticalAlignment="Center">
                                                <TextBlock Text="Beta" FontSize="10" />
                                            </Border>
                                            <Button Classes="info"
                                                    ToolTip.Tip="About the Google Sheets export"
                                                    AutomationProperties.Name="About the Google Sheets export"
                                                    Command="{Binding OpenInfoGoogleSheetsCommand}" />
                                        </StackPanel>
                                        <TextBlock Classes="hint" Text="Keeps the first tab of a spreadsheet in your Google Drive up to date (created if it doesn't exist)." />
                                    </StackPanel>
                                    <Border Grid.Column="2" Classes="pill" Classes.ready="{Binding CanExportSheets}">
                                        <TextBlock Text="{Binding SheetsStatus}" />
                                    </Border>
                                </Grid>
                                <WrapPanel Classes="fields">
                                    <StackPanel Classes="field-row">
                                        <TextBox Classes="field" PlaceholderText="Spreadsheet name"
                                                 Text="{Binding GoogleSheetsTableName, Mode=TwoWay}" />
                                    </StackPanel>
                                </WrapPanel>
                                <WrapPanel Classes="actions" Margin="0,4,0,0">
                                    <Button Classes="accent" Content="Export to Google Sheets"
                                            Command="{Binding ExportToGoogleSheetsCommand}"
                                            ToolTip.Tip="{Binding SheetsHint}" ToolTip.ShowOnDisabled="True" />
                                    <Button Content="Find duplicates…" Command="{Binding FindSheetsDuplicatesCommand}"
                                            ToolTip.Tip="Find rows of the same game in the sheet and merge them (you confirm first)"
                                            ToolTip.ShowOnDisabled="True" />
                                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Classes="last-sync" Text="{Binding SheetsLastSync}" />
                                        <TextBlock Classes="last-sync" Text="{Binding SheetsProgress}"
                                                   ToolTip.Tip="Rows with Completed ticked in the sheet, as of the last export" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Automation ===== -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Classes="page">
                        <TextBlock Classes="page-title" Text="Automation" />
                        <TextBlock Classes="page-subtitle"
                                   Text="Keep your trackers up to date without opening Pilewise." />

                        <Border Classes="panel">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="panel-title" Text="Auto-sync" />
                                <TextBlock Classes="hint"
                                           Text="Syncs on a schedule while Pilewise is open or in the tray. Notion changes are applied without the preview; every run is listed in History." />
                                <!-- Wraps on a narrow window; "Schedule" and its box stay together. -->
                                <WrapPanel ItemSpacing="16" LineSpacing="8" Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Text="Schedule" VerticalAlignment="Center" />
                                        <ComboBox Width="140" AutomationProperties.Name="Auto-sync interval"
                                                  ItemsSource="{Binding AutoSyncIntervalLabels}"
                                                  SelectedIndex="{Binding AutoSyncIntervalIndex}" />
                                    </StackPanel>
                                    <CheckBox Classes="include" Content="Notion" IsChecked="{Binding AutoSyncNotion}"
                                              IsEnabled="{Binding IsAutoSyncOn}" />
                                    <CheckBox Classes="include" Content="Google Sheets" IsChecked="{Binding AutoSyncSheets}"
                                              IsEnabled="{Binding IsAutoSyncOn}" />
                                    <CheckBox Classes="include" Content="CSV file" IsChecked="{Binding AutoSyncCsv}"
                                              IsEnabled="{Binding IsAutoSyncOn}" />
                                </WrapPanel>
                                <TextBlock Classes="hint" Text="{Binding AutoSyncCsvHint, StringFormat='CSV: {0}'}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="panel">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="panel-title" Text="Run in the background" />
                                <StackPanel Spacing="2">
                                    <CheckBox Classes="include" Content="Close to tray" IsChecked="{Binding CloseToTray}"
                                              IsEnabled="{Binding IsTrayAvailable}" />
                                    <TextBlock Classes="hint" Margin="28,0,0,0" Text="{Binding CloseToTrayHint}" />
                                </StackPanel>
                                <StackPanel Spacing="2" IsVisible="{Binding CanStartAtLogin}">
                                    <CheckBox Classes="include" Content="Start at login" IsChecked="{Binding StartAtLogin}" />
                                    <TextBlock Classes="hint" Margin="28,0,0,0" Text="{Binding StartAtLoginHint}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="panel">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="panel-title" Text="History" />
                                    <TextBlock Classes="hint"
                                               Text="Every sync (manual, scheduled, from the tray or the command line) with its result." />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open history…" VerticalAlignment="Center"
                                        Command="{Binding ShowSyncHistoryCommand}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Settings ===== -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Classes="page">
                        <TextBlock Classes="page-title" Text="Settings" />
                        <TextBlock Classes="page-subtitle" Text="Appearance, your settings file and help." />

                        <Border Classes="panel">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="panel-title" Text="Theme" />
                                    <TextBlock Classes="hint" Text="System, light or dark. System follows your OS setting." />
                                </StackPanel>
                                <views:ThemeSwitch Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Classes="panel">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="panel-title" Text="Settings file" />
                                <TextBlock Classes="hint"
                                           Text="Save your keys and options to move them to another computer, or load a saved file (you can also drop it on this window). The file is plain text: keep it private." />
                                <WrapPanel Classes="actions">
                                    <Button Content="Save settings…" Command="{Binding SaveSettingsCommand}" />
                                    <Button Content="Import settings…" Command="{Binding ImportSettingsCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="panel">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="panel-title" Text="Updates" />
                                    <TextBlock Classes="hint" Text="{Binding UpdateStatus}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                            Margin="16,0,0,0">
                                    <Button Classes="refresh" Classes.spinning="{Binding IsCheckingForUpdate}"
                                            IsEnabled="{Binding CanCheckForUpdates}"
                                            ToolTip.Tip="{Binding CheckUpdatesTip}" ToolTip.ShowOnDisabled="True"
                                            AutomationProperties.Name="{Binding CheckUpdatesLabel}"
                                            Command="{Binding CheckForUpdatesCommand}">
                                        <PathIcon Data="{DynamicResource RefreshIcon}">
                                            <PathIcon.RenderTransform>
                                                <RotateTransform />
                                            </PathIcon.RenderTransform>
                                        </PathIcon>
                                    </Button>
                                    <Button Classes="accent" Content="Download &amp; restart" IsVisible="{Binding IsUpdateAvailable}"
                                            Command="{Binding InstallUpdateCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Classes="panel">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="panel-title" Text="Help" />
                                <TextBlock Classes="hint"
                                           Text="The documentation covers setup for every store and tracker; the log files help with bug reports." />
                                <TextBlock Classes="hint" Text="{x:Static vm:MainWindowViewModel.ShortcutsText}" />
                                <WrapPanel Classes="actions">
                                    <Button Content="Documentation" Command="{Binding OpenReadmeCommand}" />
                                    <Button Content="Open log folder" Command="{Binding OpenLogsFolderCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Carousel>
        </Grid>

        <!-- Shown while a file is dragged over the window (see MainWindow.axaml.cs). -->
        <Border x:Name="DropOverlay" Grid.Column="0" Grid.ColumnSpan="2" Margin="12"
                IsVisible="False" IsHitTestVisible="False" CornerRadius="10"
                Background="#E6202020" BorderBrush="#803B82F6" BorderThickness="2">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                <TextBlock Text="Drop the file here" FontSize="20" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="A Pilewise game list (.csv) is updated with your current library;"
                           Foreground="#DDFFFFFF" HorizontalAlignment="Center" />
                <TextBlock Text="a saved settings file is imported."
                           Foreground="#DDFFFFFF" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
