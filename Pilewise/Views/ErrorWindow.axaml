<views:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:Pilewise.Views"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="300"
                    x:Class="Pilewise.Views.ErrorWindow"
                    x:DataType="views:ErrorWindow"
                    Icon="/Assets/Pilewise.ico"
                    Title="Error"
                    Width="560" Height="320" MinWidth="400" MinHeight="240"
                    WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto">
        <Grid Margin="24,20,24,16" RowDefinitions="Auto,*">
            <!-- Warning badge + the window's title (the specific error kind). -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,14">
                <Border Width="36" Height="36" CornerRadius="18" Background="#26EF4444">
                    <TextBlock Text="!" FontSize="20" FontWeight="Bold" Foreground="#EF4444"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Classes="dialog-title" Text="{Binding $parent[Window].Title}" />
                    <TextBlock Classes="hint" Text="Details below; Copy puts them on the clipboard for a bug report." />
                </StackPanel>
            </StackPanel>
            <Border Grid.Row="1" Classes="list-frame">
                <TextBox Text="{Binding Message}"
                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         BorderThickness="0" Background="Transparent" Padding="12,10" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Classes="dialog-footer">
            <StackPanel Classes="dialog-buttons">
                <Button Content="Copy" Click="OnCopy" />
                <Button Classes="accent cancel" Content="OK" />
            </StackPanel>
        </Border>
    </Grid>
</views:DialogWindow>
