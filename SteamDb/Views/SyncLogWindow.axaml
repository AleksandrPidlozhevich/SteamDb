<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SteamDb.ViewModels"
        xmlns:services="using:SteamDb.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="460"
        x:Class="SteamDb.Views.SyncLogWindow"
        x:DataType="vm:SyncLogViewModel"
        Icon="/Assets/gamedate.ico"
        Title="Sync history"
        Width="760" Height="480" MinWidth="520" MinHeight="280"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:SyncLogViewModel />
    </Design.DataContext>

    <Grid Margin="24,20,24,20" RowDefinitions="Auto,*">

        <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Classes="page-title" Text="Sync history" />
                <TextBlock Classes="page-subtitle" Margin="0,2,0,14" Text="{Binding Summary}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Clear" VerticalAlignment="Top" Margin="16,4,0,0"
                    Command="{Binding ClearCommand}" IsEnabled="{Binding !IsEmpty}" />
        </Grid>

        <Border Grid.Row="1" Classes="list-frame">
            <DockPanel>
                <Border DockPanel.Dock="Top" Classes="list-header">
                    <!-- Same widths as the item template below. -->
                    <Grid ColumnDefinitions="28,100,110,96,*">
                        <TextBlock Grid.Column="1" Classes="column-header" Text="WHEN" />
                        <TextBlock Grid.Column="2" Classes="column-header" Text="TARGET" />
                        <TextBlock Grid.Column="3" Classes="column-header" Text="STARTED BY" />
                        <TextBlock Grid.Column="4" Classes="column-header" Text="RESULT" />
                    </Grid>
                </Border>
                <Panel>
                    <ListBox Classes="rows" ItemsSource="{Binding Entries}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="services:SyncLogEntry">
                                <Grid ColumnDefinitions="28,100,110,96,*">
                                    <TextBlock Grid.Column="0" VerticalAlignment="Top" FontWeight="Bold"
                                               Text="{Binding StatusIcon}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Top" FontSize="12"
                                               Text="{Binding WhenText}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Top" FontSize="12"
                                               FontWeight="SemiBold" Text="{Binding Target}" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Top" FontSize="12" Opacity="0.65"
                                               Text="{Binding Source}" />
                                    <SelectableTextBlock Grid.Column="4" VerticalAlignment="Top" FontSize="12"
                                                         TextWrapping="Wrap" Text="{Binding Summary}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                               Text="No syncs yet. Exports, auto-sync and SteamDb --sync runs are listed here."
                               IsVisible="{Binding IsEmpty}" />
                </Panel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
