<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SteamDb.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
        x:Class="SteamDb.Views.LibraryWindow"
        x:DataType="vm:LibraryViewModel"
        Icon="/Assets/gamedate.ico"
        Title="Game library"
        Width="920" Height="580" MinWidth="620" MinHeight="320"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:LibraryViewModel />
    </Design.DataContext>

    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Search + platform filter + count. -->
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,12">
            <TextBox Grid.Column="0" PlaceholderText="Search by name…"
                     Text="{Binding SearchText, Mode=TwoWay}" />
            <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="190"
                      ItemsSource="{Binding Filters}"
                      SelectedItem="{Binding SelectedFilter, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LibraryFilterOption">
                        <TextBlock>
                            <Run Text="{Binding Label}" />
                            <Run Text="{Binding Count, StringFormat=' ({0})'}" Foreground="Gray" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="2" Margin="8,0,0,0" MinWidth="170"
                      ItemsSource="{Binding Sorts}"
                      SelectedItem="{Binding SelectedSort, Mode=TwoWay}" />
            <Button Grid.Column="3" Margin="8,0,0,0" Content="🎲 Pick for me"
                    Command="{Binding PickForMeCommand}"
                    ToolTip.Tip="Suggest a game to play from the list shown: skips completed and hidden games, and prefers ones you've barely touched" />
            <TextBlock Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7"
                       Text="{Binding Summary}" />
        </Grid>

        <!-- Pick for me: the suggestion, its store page, another pick. -->
        <Border Grid.Row="1" Classes="banner info" Margin="0,0,0,10">
            <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="HasPicked" />
                    <Binding Path="PickMessage" Converter="{x:Static ObjectConverters.IsNotNull}" />
                </MultiBinding>
            </Border.IsVisible>
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" Text="{Binding PickedText}"
                           IsVisible="{Binding HasPicked}" />
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                           Text="{Binding PickMessage}" IsVisible="{Binding !HasPicked}" />
                <Button Grid.Column="1" Content="Store page"
                        Command="{Binding OpenStorePageCommand}" CommandParameter="{Binding Picked}">
                    <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="CanOpenStorePage" />
                            <Binding Path="Picked.HasStoreUrl" FallbackValue="False" />
                        </MultiBinding>
                    </Button.IsVisible>
                </Button>
                <Button Grid.Column="2" Content="Another" Margin="6,0,0,0"
                        Command="{Binding PickForMeCommand}" IsVisible="{Binding HasPicked}" />
                <Button Grid.Column="3" Classes="dismiss" Command="{Binding DismissPickCommand}" />
            </Grid>
        </Border>

        <!-- Column headers (same widths as the item template below). -->
        <Grid Grid.Row="2" ColumnDefinitions="*,170,80,100,220,76" Margin="12,0,12,4">
            <TextBlock Grid.Column="0" Classes="column-header" Text="Name" />
            <TextBlock Grid.Column="1" Classes="column-header" Text="Platform" />
            <TextBlock Grid.Column="2" Classes="column-header" Text="Playtime" />
            <TextBlock Grid.Column="3" Classes="column-header" Text="Last played" />
            <TextBlock Grid.Column="4" Classes="column-header" Text="ID" />
        </Grid>

        <Border Grid.Row="3" Classes="list-frame">
            <Panel>
                <ListBox ItemsSource="{Binding VisibleGames}" Background="Transparent"
                         SelectedItem="{Binding SelectedGame, Mode=TwoWay}" AutoScrollToSelectedItem="True"
                         DoubleTapped="OnGameDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LibraryGameItem">
                            <Grid ColumnDefinitions="*,170,80,100,220,76">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="✓" FontWeight="Bold" Foreground="#2E9E5B"
                                               IsVisible="{Binding IsCompleted}" ToolTip.Tip="Completed" />
                                    <Border Classes="chip new" IsVisible="{Binding IsNew}"
                                            ToolTip.Tip="{Binding AddedText}">
                                        <TextBlock Text="NEW" FontSize="9" FontWeight="Bold" />
                                    </Border>
                                    <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Name}"
                                               ToolTip.Tip="Double-click to open the store page" />
                                </StackPanel>
                                <ItemsControl Grid.Column="1" VerticalAlignment="Center"
                                              ItemsSource="{Binding Platforms}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Classes="chip">
                                                <TextBlock FontSize="11" Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12"
                                           Text="{Binding PlaytimeText}" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12"
                                           Text="{Binding LastPlayedText}" />
                                <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11"
                                           Opacity="0.7" TextTrimming="CharacterEllipsis"
                                           Text="{Binding Id}" ToolTip.Tip="{Binding Id}" />
                                <!-- Hide / Unhide: leaves the game out of every export (saved). -->
                                <Button Grid.Column="5" FontSize="11" Padding="8,2" HorizontalAlignment="Right"
                                        Content="{Binding HideLabel}" ToolTip.Tip="{Binding HideTip}"
                                        IsVisible="{Binding $parent[ListBox].((vm:LibraryViewModel)DataContext).CanHide}"
                                        Command="{Binding $parent[ListBox].((vm:LibraryViewModel)DataContext).ToggleHiddenCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                           Text="No games match the search."
                           IsVisible="{Binding !HasVisibleGames}" />
            </Panel>
        </Border>

        <!-- Library totals (hidden games excluded; search and filter don't change them). -->
        <WrapPanel Grid.Row="4" Margin="2,10,0,0" Orientation="Horizontal">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,4"
                        IsVisible="{Binding Stats.HasCompletion}" ToolTip.Tip="{Binding Stats.CompletedTip}">
                <ProgressBar Width="120" MinWidth="120" Height="6" MinHeight="6" VerticalAlignment="Center"
                             Minimum="0" Maximum="100" Value="{Binding Stats.CompletedPercent}"
                             Foreground="#2E9E5B" />
                <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           Text="{Binding Stats.CompletedText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,4"
                        IsVisible="{Binding Stats.HasPlaytimeData}" ToolTip.Tip="{Binding Stats.PlayedTip}">
                <ProgressBar Width="120" MinWidth="120" Height="6" MinHeight="6" VerticalAlignment="Center"
                             Minimum="0" Maximum="100" Value="{Binding Stats.PlayedPercent}" />
                <TextBlock FontSize="12" VerticalAlignment="Center" Text="{Binding Stats.PlayedText}" />
            </StackPanel>
            <TextBlock FontSize="12" Opacity="0.75" Margin="0,0,20,4" VerticalAlignment="Center"
                       IsVisible="{Binding Stats.HasPlaytimeData}" Text="{Binding Stats.TotalText}" />
            <TextBlock FontSize="12" Opacity="0.75" Margin="0,0,20,4" VerticalAlignment="Center"
                       IsVisible="{Binding Stats.HasPlaytimeData}" Text="{Binding Stats.NeverPlayedText}" />
            <TextBlock FontSize="12" Opacity="0.75" Margin="0,0,20,4" VerticalAlignment="Center"
                       Text="{Binding Stats.MultiStoreText}" />
            <TextBlock FontSize="12" Opacity="0.75" Margin="0,0,20,4" VerticalAlignment="Center"
                       IsVisible="{Binding Stats.HasRecentlyAdded}" Text="{Binding Stats.RecentlyAddedText}"
                       ToolTip.Tip="Games SteamDb saw for the first time recently (stores don't report purchase dates, so this counts from when SteamDb started tracking each store)" />
            <TextBlock FontSize="12" Opacity="0.75" Margin="0,0,0,4" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="360"
                       Text="{Binding Stats.MostPlayedText}" ToolTip.Tip="{Binding Stats.MostPlayedText}" />
        </WrapPanel>
    </Grid>
</Window>
