<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationIcon>gamedate.ico</ApplicationIcon>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="gamedate.ico" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Google.Apis.Drive.v3" Version="1.77.0.4276" />
        <PackageReference Include="Google.Apis.Sheets.v4" Version="1.77.0.4290" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
        <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.91.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
        <PackageReference Include="Velopack" Version="1.2.161" />
    </ItemGroup>
</Project>
